{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Loading Gemini host contract",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^(write_to_file|replace_file_content|apply_patch|write|edit|bash|execute_command|run_command)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" pre-tool-use",
						"timeout": 5,
						"statusMessage": "LazyForensic: Guarding Evidence Integrity (Write-Lock, best-effort)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(write_to_file|replace_file_content|generate_document|fill_form)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" post-tool-use",
						"timeout": 5,
						"statusMessage": "LazyForensic: Logging SHA-256 Audit Trail",
						"failurePolicy": "FAIL_OPEN"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hallucination_guard.mjs\"",
						"timeout": 10,
						"statusMessage": "LazyForensic: Verifying report (보고서/검토해줘 무조건 검증)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Restoring Gemini host contract",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		]
	}
}
